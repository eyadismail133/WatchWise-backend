# Copy to .env and replace placeholders. Never commit .env or real credentials.
# Use an isolated database for development writes, migrations, and tests.
DATABASE_URL=postgresql://watchwise:local-password@localhost:5432/watchwise_dev
BETTER_AUTH_SECRET=replace-with-a-random-development-only-secret
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
TMDB_API_KEY=replace-with-your-tmdb-api-key
GROQ_API_KEY=replace-with-your-groq-api-key
PORT=3000
NODE_ENV=development
